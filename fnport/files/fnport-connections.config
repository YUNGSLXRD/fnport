config connections 'main'
 option enabled '0'
 option protocol 'warp'
 option epic '1'
 option discord '0'
 option wan_interface 'wan'
 list lan_interface 'lan'
 option dns_mode 'https'
 option dns_provider 'cloudflare'
 option fake_ttl '3'
 option fake_file '/usr/share/fnport/quic_initial_vk_com.bin'
