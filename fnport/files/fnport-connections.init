#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=9

start_service() {
 config_load fnport_connections
 local enabled
 config_get_bool enabled main enabled 0
 [ "$enabled" = 1 ] || return 0
 [ -x /usr/libexec/fnport-connections-helper ] && [ -x /usr/lib/fnport-connections/sing-box ] || {
  logger -t fnport-connections 'Install connection components in LuCI first'
  return 1
 }
 umask 077
 mkdir -p /var/run/fnport-connections
 chmod 700 /var/run/fnport-connections
 if ! ucode /usr/share/fnport/connections-config.uc > /var/run/fnport-connections/config.tmp; then
  rm -f /var/run/fnport-connections/config.tmp
  logger -t fnport-connections 'Invalid connection settings or WAN/LAN interface unavailable'
  return 1
 fi
 mv /var/run/fnport-connections/config.tmp /var/run/fnport-connections/config.json
 procd_open_instance
 procd_set_param command /usr/libexec/fnport-connections-helper run /var/run/fnport-connections/config.json
 procd_set_param file /etc/config/fnport_connections
 procd_set_param respawn 3600 5 0
 procd_set_param term_timeout 10
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
service_triggers() {
 local wan
 config_load fnport_connections
 config_get wan main wan_interface wan
 procd_add_reload_trigger fnport_connections
 procd_add_interface_trigger 'interface.*.up' "$wan" /etc/init.d/fnport-connections restart
}
