
config fnport 'main'
	# 1 = service active
	option enabled '0'
	# logical interface facing the ISP (its L3 device is detected automatically)
	option wan_interface 'wan'
	# LAN devices whose game traffic is handled (use static DHCP leases)
	#list device '192.168.1.100'
	# server UDP ports of the game; defaults are Fortnite (control 15xxx, match 9xxx)
	list port_range '9000-9999'
	list port_range '15000-15999'
	# Fortnite pairs the match port with the control port by suffix (15062 -> 9062):
	# probe the match port right after the control port is seen. Empty = disabled.
	option pair_from '15000-15999'
	option pair_offset '-6000'
	# server UDP echo used when the game port does not answer handshakes
	option qos_port '22222'
	# ports probed in parallel per round, rounds per flow (2 x 8 = up to 16 ports, gentle on the DPI)
	option probe_batch '2'
	option max_rounds '8'
	# seconds a probe verdict is reused (verdicts drift after ~10-20 minutes)
	option verdict_ttl '90'
	# probe sockets per minute for all servers together (too much probing gets the address punished)
	option probe_budget '24'
	# fake QUIC Initial with a whitelisted SNI, sent once per probe/flow before the real packets:
	# TSPU does not freeze flows where it saw such an SNI. Empty = disabled.
	option whitelist_fake '/usr/share/fnport/quic_initial_vk_com.bin'
	# TTL of the fake (hops from the router): must expire past the TSPU but before the server
	option fake_ttl '3'
