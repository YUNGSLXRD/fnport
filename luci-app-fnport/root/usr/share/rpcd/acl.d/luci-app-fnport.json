{
	"luci-app-fnport": {
		"description": "Grant access to fnport configuration and status",
		"read": {
			"file": {
				"/sbin/logread -e fnport": [
					"exec"
				],
				"/usr/libexec/fnport-check status": [
					"exec"
				]
			},
			"ubus": {
				"luci-rpc": [
					"getHostHints"
				],
				"service": [
					"list"
				]
			},
			"uci": [
				"fnport"
			]
		},
		"write": {
			"file": {
				"/usr/libexec/fnport-check start": [
					"exec"
				],
				"/usr/libexec/fnport-check apply": [
					"exec"
				]
			},
			"uci": [
				"fnport"
			]
		}
	}
}
